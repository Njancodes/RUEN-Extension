{
  "manifest_version": 3,
  "name": "RUEN Extension",
  "version": "0.5",
  "description": "Encrypt your whatsapp messsages before sending it.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ruen-nexus@nijo.com",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/","file:///*"
      ],
      "js": [
        "dist/content.js"
      ]
    }
  ],
  "background": {
    "scripts": [
      "dist/background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "commands": {
    "encrypt-shortcut": {
      "suggested_key": {
        "default": "Ctrl+Shift+B"
      },
      "description": "Shortcut to encrypt the message"
    }
  },
  "action": {
    "default_icon": "icons/extension_icon.svg",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "32": "icons/extension_icon.svg",
    "64": "icons/extension_icon.svg"
  }
}